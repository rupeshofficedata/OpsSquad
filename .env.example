# ── Core ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
POSTGRES_USER=opssquad
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opssquad
DATABASE_URL=postgresql://opssquad:change-me@postgres:5432/opssquad

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────
# REQUIRED — both services refuse to start without it (and refuse the old
# placeholder value too, since it's public in this repo's git history).
# Generate: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── LLM Providers ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
INTENT_ROUTER_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5
# Per-user "local" model provider target — an OpenAI-compatible server
# (llama-server, Ollama, vLLM, ...). Under docker compose, "localhost" is
# the container itself, not the host — use host.docker.internal (Docker
# Desktop) or your bridge gateway IP instead. The k8s path
# (k8s/01-configmap.yaml) documents the equivalent for kind.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# ── Real tool integrations ────────────────────────────
# Off by default here on purpose: kubectl needs a real kubeconfig/RBAC this
# compose setup doesn't provide (unlike k8s/05-rbac.yaml's ServiceAccount),
# so a real kubectl call would just fail and agents would silently see empty
# data. terraform and trivy work fine under compose if you flip this on.
REAL_TOOLS_ENABLED=false

# ── Service URLs (internal) ───────────────────────────
BFF_PORT=4000
RUNTIME_URL=http://runtime:8000
FRONTEND_ORIGIN=http://localhost:5173

# ── Kill switch ───────────────────────────────────────
MUTATING_AGENTS_ENABLED=true

# ── Webhooks ──────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=
# Required — the alertmanager webhook rejects every request without it.
# Set in webhook_configs.http_config.authorization.credentials on the
# Alertmanager side.
ALERTMANAGER_WEBHOOK_TOKEN=
